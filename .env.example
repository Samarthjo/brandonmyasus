# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Optional: Formspree form endpoint (https://formspree.io) — fires an
# email to you the instant someone submits a bid. Without this, bids
# still land in Supabase and show up on /admin, you just won't get an
# email ping and have to check /admin manually.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
